{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": [
    "ultracite/biome/core",
    "ultracite/biome/type-aware",
    "ultracite/biome/react",
    "ultracite/biome/next"
  ],
  "linter": {
    "rules": {
      "correctness": {
        // Biome cannot follow Bun's isolated-install symlinks; `tsc` already reports unresolved imports
        "noUnresolvedImports": "off",
        // Bundler resolution: extensions would break `@workspace/ui` package-export subpaths
        "useImportExtensions": "off"
      }
    }
  },
  "overrides": [
    {
      // Re-export modules required by the shadcn monorepo layout
      "includes": ["**/postcss.config.mjs", "packages/ui/src/lib/utils.ts"],
      "linter": { "rules": { "performance": { "noBarrelFile": "off" } } }
    }
  ]
}
